{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".env"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "dist/**"
      ],
      "env": [
        "NEXT_PUBLIC_*",
        "SUPABASE_*",
        "RAZORPAY_*",
        "AGNES_*",
        "R2_*",
        "SENTRY_*"
      ]
    },
    "build:worker": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".open-next/**"
      ],
      "env": [
        "NEXT_PUBLIC_*",
        "SUPABASE_*",
        "RAZORPAY_*",
        "AGNES_*",
        "R2_*",
        "SENTRY_*"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {},
    "typecheck": {}
  }
}
