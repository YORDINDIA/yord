# ================================
# YORD INDIA — single env file for the whole monorepo
# ================================
# Copy this file to .env (repo root) and fill in real values.
# NEVER commit .env to version control.
#
# Both Next.js apps (frontend/, admin-dashboard/) load this file automatically
# via dotenv-cli (`dotenv -e ../.env` in their npm scripts). Python scripts in
# scripts/ load it via python-dotenv. On the hosting platform and in CI the
# vars come from the environment instead: a missing file is silently ignored
# and exported vars always win over file values.

# ================================
# SUPABASE — shared (frontend + admin + scripts)
# ================================
# Supabase Project URL
# Get from: Supabase Dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Publishable Key (safe for client-side, limited permissions)
# Get from: Supabase Dashboard → Project Settings → API Keys → Publishable and secret API keys
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase Secret Key (SECRET - server-side only, bypasses RLS)
# Get from: Supabase Dashboard → Project Settings → API Keys → Publishable and secret API keys
# WARNING: Never expose this in client-side code or commit to git
SUPABASE_SECRET_KEY=

# ================================
# SUPABASE — scripts override (optional)
# ================================
# Migration scripts read SUPABASE_URL first, then fall back to
# NEXT_PUBLIC_SUPABASE_URL above. Set this only if scripts must target a
# different project than the apps (normally leave empty — it must otherwise
# point at the SAME project or migration writes go to the wrong place).
SUPABASE_URL=

# ================================
# SUPABASE DATABASE — direct PostgreSQL (psql schema setup)
# ================================
# Get from: Supabase Dashboard → Project Settings → Database
# Used for: psql "$DATABASE_URL" -f scripts/schema.sql (and schema_patches/)

# Database host (format: db.your-project-id.supabase.co)
SUPABASE_DB_HOST=db.your-project-id.supabase.co

# Database port (default is 5432, use 6543 for connection pooling)
SUPABASE_DB_PORT=5432

# Database name (always "postgres" for Supabase)
SUPABASE_DB_NAME=postgres

# Database user (default is "postgres")
SUPABASE_DB_USER=postgres

# Database password (reset it under Project Settings → Database if forgotten)
SUPABASE_DB_PASSWORD=your-database-password-here

# Full connection string (alternative to the individual parameters above)
# Format: postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres

# ================================
# CLOUDFLARE R2 — object storage (admin uploads + migration scripts)
# ================================
# Media lives in one R2 bucket and is delivered as plain object reads through
# R2_PUBLIC_BASE_URL. There is no transform service: every image is stored as a
# single web-optimized WebP variant (max 1600px wide), produced by the browser
# on admin uploads and by Pillow in scripts/ (see utils/r2_helpers.py).
#
# Consumers: the admin site (media + AI uploads) and scripts/ (media ingest).
# The storefront never needs these — it only renders stored URLs, through the
# loader in frontend/src/lib/media-loader.ts.

# Cloudflare account id. Dashboard → R2 → Account details → Account ID.
R2_ACCOUNT_ID=

# R2 API token pair: R2 → Manage API tokens → Create (permission
# "Object Read & Write" scoped to this bucket). The Access Key ID is the
# token's id and the Secret Access Key is the token's SHA-256 hash — copy both
# when the token is created, the secret is not shown again.
# WARNING: server-side only — never expose these to the browser.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Bucket name that holds media (create it first; suggested: yord-media).
R2_BUCKET=

# Public delivery base URL. Until a custom domain is connected this is the
# bucket's public development URL: R2 → bucket → Settings → Public Development
# URL → Enable → copy https://pub-<hash>.r2.dev.
# NOTE: r2.dev is rate-limited and Cloudflare marks it non-production. Connect a
# custom domain before launch and point this (and NEXT_PUBLIC_MEDIA_BASE_URL)
# at it; no database rewrite is needed.
R2_PUBLIC_BASE_URL=

# Optional overrides — leave empty unless you know you need them.
# Explicit S3 endpoint (replaces the derived one, e.g. a local test endpoint).
R2_ENDPOINT=
# Bucket jurisdiction for buckets created in one: eu | fedramp | us.
R2_JURISDICTION=

# ================================
# CLOUDFLARE — deployment management (not read by app code)
# ================================
# Used by the CLI/API when managing Workers, R2 and DNS. Create a scoped token
# at Cloudflare → My Profile → API Tokens (permissions: Workers Scripts:Edit,
# R2:Edit, and Zone:Read for the domain you connect).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Zone id of the domain that will serve media (only needed when connecting a
# custom domain or managing DNS through the API).
CLOUDFLARE_ZONE_ID=

# ================================
# SUPABASE — management (deployment scripts only, not read by app code)
# ================================
# Personal access token for the Supabase CLI / Management API
# (Dashboard → Account → Access Tokens). Lets scripts apply migrations and
# manage the project without a direct database password.
SUPABASE_ACCESS_TOKEN=

# Project ref (the subdomain in https://<ref>.supabase.co).
# Reserved for future scripts; nothing reads it yet.
SUPABASE_PROJECT_REF=

# ================================
# APP CONFIG (frontend)
# ================================
# Note: NEXT_PUBLIC_APP_URL and NEXT_PUBLIC_APP_NAME are set but currently read
# by no code — kept for metadata/OG work.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=YORD India

# Public media base for the storefront loader: leave empty to serve stored URLs
# as-is; set it (https://media.example.com) to rewrite stored *.r2.dev URLs to
# that origin without touching the database.
NEXT_PUBLIC_MEDIA_BASE_URL=

# Concept-design routes under /concepts/* (stagelight, poster, halftone).
# Read by frontend/src/features/concepts/gate.ts; anything but "true" hides
# them (404), and production deployments should leave it unset.
NEXT_PUBLIC_SHOW_CONCEPTS=

# ================================
# RAZORPAY (frontend checkout + admin refunds)
# ================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ================================
# ANALYTICS & MONITORING (frontend + admin)
# ================================
# Every integration below is env-gated: an empty value disables it, so local
# dev and CI builds run with none of them enabled.

# --- PostHog (frontend + admin) ---
# Product analytics; the storefront also records sessions. Free tier: 1M
# events and 5k session recordings per month.
# PostHog Project API Key
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# PostHog API Host
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Google Analytics 4 (storefront only) ---
# Measurement ID of the GA4 web data stream (GA → Admin → Data streams →
# Web → Measurement ID), format G-XXXXXXXXXX. Empty = no GA script is
# rendered. Free; pageviews (including SPA route changes) are automatic.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Google Search Console (storefront only) ---
# Verification token for a URL-prefix property (Search Console → Settings →
# Ownership verification → HTML tag → copy only the content="..." value).
# Rendered as <meta name="google-site-verification"> on every page. A Domain
# property verified by a DNS TXT record needs nothing here.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Sentry (frontend + admin, errors only) ---
# Free tier is error monitoring only: tracing, session replay, profiling and
# logs are paid and stay disabled in code (tracesSampleRate: 0).
# DSN from Sentry → Project Settings → Client Keys. Public by design; empty
# disables Sentry (nothing is sent from local dev either).
NEXT_PUBLIC_SENTRY_DSN=

# Organization slug, project slug, and an org auth token (Sentry → Settings →
# Auth Tokens) used to upload source maps at build time so stack traces are
# readable. Build-time only, never shipped to the browser; without them the
# build still succeeds and simply skips the upload (CI does this).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ================================
# AGNES AI (admin AI studio + listing endpoints)
# ================================
# API key for the Agnes AI API hub (https://apihub.agnes-ai.com)
AGNES_AI_API_KEY=
# Base URL including /v1 (code default: https://apihub.agnes-ai.com/v1)
AGNES_BASE_URL=
# Model overrides (code defaults: agnes-3.0-flash / agnes-image-2.5-flash)
AGNES_TEXT_MODEL=
AGNES_IMAGE_MODEL=

# ================================
# SHOPIFY ADMIN API (migration scripts only)
# ================================
# Your Shopify store subdomain (from your admin URL)
# Example: For 5217cc-15.myshopify.com, use "5217cc-15"
# (Legacy SHOPIFY_STORE is still accepted with a deprecation warning.)
SHOPIFY_STORE_NAME=5217cc-15

# Shopify Admin API Access Token (starts with shpat_)
# How to get:
#   1. Go to Shopify Admin → Settings → Apps and sales channels
#   2. Click "Develop apps" → "Create an app"
#   3. Configure Admin API scopes with READ access to:
#      - read_products
#      - read_customers
#      - read_orders
#      - read_discounts
#      - read_inventory
#      - read_price_rules
#   4. Install the app and copy the Admin API access token
SHOPIFY_ADMIN_API_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shopify API Version (latest stable)
SHOPIFY_API_VERSION=2025-01

# ================================
# MIGRATION TUNING (scripts only, all optional)
# ================================
# Date range for incremental sync (YYYY-MM-DD format)
# Leave empty to sync ALL data from the beginning
SYNC_FROM_DATE=
SYNC_TO_DATE=

# Batch size for Shopify API requests (max 250)
BATCH_SIZE=250

# Rows per Supabase upsert batch
SUPABASE_UPSERT_BATCH_SIZE=500

# Retry behaviour for Shopify/REST calls
RETRY_LIMIT=5
RETRY_WAIT=2

# Enable verbose/debug logging (true/false)
DEBUG=false

# ================================
# NOTES FOR YORD INDIA MIGRATION
# ================================
# 1. Create a Shopify Custom App with read access to all required scopes
# 2. Create a Supabase project if you haven't already
# 3. Apply the schema: psql "$DATABASE_URL" -f scripts/schema.sql,
#    then supabase/migrations/ in numeric order (see scripts/README.md)
# 4. Create the R2 bucket, enable its public URL and set the R2_* vars above.
#    All media lives there as pre-built WebP variants; the archive-era Supabase
#    project is deleted, so any ...supabase.co/storage/... URL 404s.
#    Deploy notes: docs/deploy.md
# 5. Run the migration scripts in order (see scripts/README.md)

# ── Admin UI visual QA (optional, test-only) ───────────────────────────────
# Credentials for the automated browser checks against a local dev server.
# Leave blank in real deployments; never commit real credentials.
ADMIN_TEST_EMAIL=
ADMIN_TEST_PASSWORD=
