# ================================
# YORD INDIA - Shopify to Supabase Migration
# ================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ================================
# SHOPIFY ADMIN API CREDENTIALS
# ================================
# Your Shopify store subdomain (from your admin URL)
# Example: For 5217cc-15.myshopify.com, use "5217cc-15"
SHOPIFY_STORE_NAME=5217cc-15

# Shopify Admin API Access Token (starts with shpat_)
# How to get:
#   1. Go to Shopify Admin → Settings → Apps and sales channels
#   2. Click "Develop apps" → "Create an app"
#   3. Configure Admin API scopes with READ access to:
#      - read_products
#      - read_customers
#      - read_orders
#      - read_discounts
#      - read_inventory
#      - read_price_rules
#   4. Install the app and copy the Admin API access token
SHOPIFY_ADMIN_API_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shopify API Version (latest stable)
SHOPIFY_API_VERSION=2025-01

# ================================
# SUPABASE CREDENTIALS
# ================================
# Supabase Project URL
# Get from: Supabase Dashboard → Project Settings → API → Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Key (safe for client-side, limited permissions)
# Get from: Supabase Dashboard → Project Settings → API → Project API keys → anon public
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Supabase Service Role Key (SECRET - server-side only, bypasses RLS)
# Get from: Supabase Dashboard → Project Settings → API → Project API keys → service_role
# WARNING: Never expose this in client-side code or commit to git
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# ================================
# SUPABASE DATABASE (Direct PostgreSQL Connection)
# ================================
# Used by migration scripts for direct database access via psycopg2
# Get from: Supabase Dashboard → Project Settings → Database → Connection string

# Database host (format: db.your-project-id.supabase.co)
SUPABASE_DB_HOST=db.your-project-id.supabase.co

# Database port (default is 5432, use 6543 for connection pooling)
SUPABASE_DB_PORT=5432

# Database name (always "postgres" for Supabase)
SUPABASE_DB_NAME=postgres

# Database user (default is "postgres")
SUPABASE_DB_USER=postgres

SUPABASE_CONNECTION_STRING=

# Database password
# Get from: Supabase Dashboard → Project Settings → Database → Database password
# If you forgot it, you can reset it in the same location
SUPABASE_DB_PASSWORD=your-database-password-here

# Full connection string (alternative to individual parameters above)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres

# ================================
# SUPABASE STORAGE (for product images/media)
# ================================
# Storage bucket name for product media
# This bucket will be created automatically if it doesn't exist
SUPABASE_STORAGE_BUCKET=products

# ================================
# MIGRATION SETTINGS (Optional)
# ================================
# Date range for incremental sync (YYYY-MM-DD format)
# Leave empty to sync ALL data from the beginning
# Useful for testing with a small subset first
SYNC_FROM_DATE=
SYNC_TO_DATE=

# Batch size for API requests (max 250 for Shopify)
BATCH_SIZE=250

# Enable verbose/debug logging (true/false)
DEBUG=false

# ================================
# NOTES FOR YORD INDIA MIGRATION
# ================================
# 1. Create a Shopify Custom App with read access to all required scopes
# 2. Create a Supabase project if you haven't already
# 3. Run the database schema setup: psql -h $SUPABASE_DB_HOST -U $SUPABASE_DB_USER -d $SUPABASE_DB_NAME -f setup_supabase.sql
# 4. Create a storage bucket named "products" in Supabase Storage
# 5. Run the migration scripts in order (see README)
