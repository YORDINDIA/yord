# YORD India — storefront (frontend)
# Copy to .env.local and fill in real values. .env*.local is gitignored.

# Supabase Project Settings → API
# With these unset the app still boots: src/proxy.ts skips session refresh and
# lib/result.ts degrades reads to empty. Product grids will render empty.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the client. API routes must 500 loudly without it,
# so it is deliberately strict rather than degrading.
SUPABASE_SERVICE_ROLE_KEY=

# App config
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=YORD India

# Razorpay (checkout)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# PostHog analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
